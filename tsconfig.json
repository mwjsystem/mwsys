{
  "compileOnSave": false,
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "es2022",
    
    /* 🌟 最重要：最新のモジュール解決方式に切り替えてHttpClient等を見つけ出す */
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    
    "experimentalDecorators": true,
    "target": "es2022",
    "typeRoots": [
      "node_modules/@types"
    ],
    
    /* 🌟 明示的に依存関係の型定義をロードさせる */
    "types": [
      "node"
    ],
    "lib": [
      "es2022",
      "dom"
    ],
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    
    "strict": true
  },
  "angularCompilerOptions": {
    
    "strictTemplates": true
  }
}
